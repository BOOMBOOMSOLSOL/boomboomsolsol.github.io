---
layout: null
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{% for item in site.pages %}{% unless item.sitemap == false or item.robots contains 'noindex' %}{% assign last_character = item.url | slice: -1 %}{% if last_character == '/' %}<url><loc>{{ item.url | replace: 'index.html', '' | absolute_url | xml_escape }}</loc></url>{% endif %}{% endunless %}{% endfor %}
{% for post in site.posts %}<url><loc>{{ post.url | absolute_url | xml_escape }}</loc></url>{% endfor %}
</urlset>
